{
  "typ": "amj.trust_decision",
  "v": "integer",
  "decision_id": "string (uuid)",
  "evaluated_at": "string (ISO 8601)",
  "expires_at": "string (ISO 8601)",
  "subject": "string (did:web)",
  "for": "string (did:web)",
  "tier": "string (honored | standard | probation | restricted | suspended)",
  "score": "integer",
  "confidence": "number (0–1)",
  "verification": {
    "tier": "string (V0 | V1 | ...)",
    "claims": ["string"]
  },
  "risk_flag": "string (none | watch | warning | suspended)",
  "past": {
    "receipts": "integer",
    "completion_rate": "number (0–1)",
    "dispute_rate": "number (0–1)",
    "security_incidents_90d": "integer"
  },
  "philosophy": {
    "policy_version": "integer",
    "policy_fit": "number (0–1)",
    "conflicts": ["string"]
  },
  "present": {
    "fit": "number (0–1)",
    "least_privilege_ok": "boolean",
    "content_scan": "string",
    "anomalies": ["string"]
  },
  "lineage": {
    "probable_successor_of": "string (did:web) | null",
    "links_possible": "integer"
  },
  "outcome": "string (allow | allow_to_owner | deny)",
  "max_grantable_risk_class": "string (R0 | R1 | R2 | R3 | R4)",
  "suggested_grant": {
    "scopes": ["string"],
    "budget": {
      "max_per_action": "number",
      "currency": "string (ISO 4217)"
    },
    "expires_in_days": "integer"
  },
  "reasons": ["string (reason code)"],
  "signature": "string (JWS EdDSA)"
}
